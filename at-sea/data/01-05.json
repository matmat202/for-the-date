EEN HET WEER TOEN OP ZIJN HOOGST GEWEEST TE ZIJN, DAAR DE HAGEL OPHIELD EN IN FIJNE REGEN VERWISSELDE. TEN 4 UUR WAS DE KWIK DIE 10 LIJNEN GEDAALT WAS 1½ LIJN GEREZEN EN SEDERT ZES UUR KONDE MEN GOED BESPEUREN DE VERMINDERING VAN DE WIND, TEN 8 UUR WAS DE KWIK 4 LIJNEN GEREZEN EN HET WEER WERKELIJK BEDAARDER, HETWELK MET DE ZEE GAANDEWEG AFNAM. DW. DROOG EN HANDZAAM WEER, SLOEGEN EENE FOK, GROOTZEIL EN BEZAAN AAN. DE WIND WAS GHAANDEWEG RONDGELOPEN TOT AAN HET ZW. VM. HALSDEN OM DE NW EN STELDE KOERS. AFNEMENDE WIND TOT FLAUWTJES. MIDDAGBESTEK 28-35 ZUID 57-08 OOST."],[1850,4088,-22.7,68.3,46,34,"BRAMZEILSKOELTE EN MARSZEILSKOELTE",null,null],[1851,139,-39.8,86.1,123,339,"5-6",null,null],[1851,308,-28.3,46.1,67,112,"MARSZEILSKOELTE",null,null],[1851,584,4.0,-23.3,10,74,"FLAUW EN STIL",null,null],[1851,2888,-2.0,88.0,67,316,"4",null,null],[1851,2898,-2.0,88.0,67,316,"4",null,null],[1851,3263,-15.7,107.1,29,168,"FRISSE BOVENBRAMZEILSKOELTE",null,null],[1851,4505,-19.8,-79.9,67,136,"4",null,null],[1851,4569,-35.8,52.0,46,144,"ONGESTADIGE BRAMZEILSKOELTE",null,"SYMPISIOMETER READING: 764.5"],[1851,4817,-26.2,4.4,46,154,"3",null,null],[1851,5073,6.8,-23.7,93,18,"5",null,null],[1852,52,49.7,-3.4,123,179,"6","W00",null],[1852,1113,-32.1,-26.0,123,349,"6",null,null],[1852,2842,-34.0,28.0,154,230,"ONGESTADIG HARDE WIND",null,null],[1852,3335,-13.4,-8.0,46,null,"3","ZEER SCHOON WEER",null],[1852,4507,47.0,-19.2,67,209,"4",null,null],[1852,5071,-21.1,69.5,67,82,"4",null,null],[1853,198,52.8,4.2,null,228,null,null,null],[1853,415,-25.0,91.6,93,105,"5",null,null],[1853,1763,-34.4,18.4,46,128,"FLAUWE BRAMZEILSKOELTE, BRAMZEILSKOELTE",null,"SYMPISIOMETER: 301100. ANKER OP"],[1853,2160,-23.4,2.4,61,121,"FLAUWE PASSAATKOELTE",null,null],[1853,2203,36.7,-34.5,123,248,"6",null,null],[1853,3123,-39.6,42.1,67,229,"4",null,"THERMOMETER READING AT 9.00 AM"],[1853,3586,0.8,-25.0,46,154,"3",null,null],[1853,3806,20.1,-33.2,123,98,"6","ONGESTADIG",null],[1853,3958,-23.0,-28.6,10,126,"FLAUW",